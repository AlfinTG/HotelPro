# Server environment configuration — PLACEHOLDERS ONLY
# Copy this file to .env and fill in real values locally.
# NEVER commit .env to Git.

# Express server port (default: 8001 — see DECISIONS_AND_CONFLICTS.md D-04)
PORT=8001

# MongoDB connection URI (default: local hotel database — see D-05)
MONGO_URI=mongodb://127.0.0.1:27017/hotel

# JWT signing secret — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# Allowed frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional: Admin provisioning variables (used only when running npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-secure-admin-password
ADMIN_PHONE=1234567890
