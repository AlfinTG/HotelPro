# Client environment configuration — PLACEHOLDERS ONLY
# Copy this file to .env and fill in real values locally.
# NEVER commit .env to Git.
# Only VITE_ prefixed variables are exposed to browser code.
# Do NOT place server secrets (JWT_SECRET, MONGO_URI) here.

# Base URL of the HotelPro Express backend API
VITE_API_BASE_URL=http://localhost:8001
